# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 图片生成 (硅基流动 / 其他 OpenAI 兼容 API)
IMAGES_API_KEY=your_images_api_key_here

# WeChat Official Account
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 知乎 Cookie（可选，填写后使用官方API，否则自动降级为百度搜索）
# 获取方式：浏览器登录知乎 → F12 → Network → 任意请求 → 复制 Cookie 请求头
ZHIHU_COOKIE=
